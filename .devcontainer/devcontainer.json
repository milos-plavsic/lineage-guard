{
  "name": "LineageGuard remote validation",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "12gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "python -m pip install --disable-pip-version-check uv==0.11.25 && uv sync --locked --extra dev --extra mcp",
  "remoteUser": "vscode"
}
