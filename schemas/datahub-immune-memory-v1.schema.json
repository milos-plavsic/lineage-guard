{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineageguard.dev/schemas/datahub-immune-memory-v1.schema.json",
  "title": "LineageGuard DataHub Immune Memory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "subject_urn", "incident_id", "producer",
    "parent_digest", "payload", "record_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {
      "enum": [
        "incident", "prevention_outcome", "supersession", "expiry", "revocation"
      ]
    },
    "subject_urn": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^urn:li:"},
    "incident_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer": {"type": "string", "minLength": 1, "maxLength": 128},
    "parent_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "payload": {"type": "object"},
    "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
